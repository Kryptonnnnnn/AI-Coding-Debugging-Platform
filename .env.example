# ---- Backend (copy to backend/.env). Placeholders only; never commit real values. ----
ENVIRONMENT=development
DATABASE_URL=postgresql://aicp:aicp@localhost:5432/aicp
SECRET_KEY=change-me-to-a-long-random-string        # generate: python -c "import secrets; print(secrets.token_urlsafe(48))"
CORS_ORIGINS=http://localhost:3000                   # comma-separated list of allowed frontend origins

# AI provider: mock | groq | ollama
AI_PROVIDER=mock
ALLOW_MOCK_PROVIDER=false                            # production only: permit the canned mock provider
AI_MODEL=                                            # optional override of the provider's default model
GROQ_API_KEY=                                        # from https://console.groq.com/keys (only needed for groq)
GROQ_MODEL=llama-3.3-70b-versatile
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.1
AI_TIMEOUT_SECONDS=60

# Limits
MAX_FILE_BYTES=524288
MAX_PROJECT_BYTES=20971520
MAX_ZIP_BYTES=10485760
RATE_LIMIT_PER_MINUTE=120
AI_RATE_LIMIT_PER_MINUTE=20

# Code execution is OFF by default and fails closed. See sandbox/README.md before enabling.
EXECUTION_ENABLED=false
SANDBOX_IMAGE=aicp-sandbox:latest

# ---- Frontend (frontend/.env.local) ----
NEXT_PUBLIC_API_URL=http://localhost:8000
